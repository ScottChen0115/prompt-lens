{
  "checkpoint": "configs/checkpoint-bilingual.json",
  "task": "bilingual_request_quality_multilabel",
  "data_root": "data/processed/supplied-v1",
  "sources": ["brq", "rq"],
  "parameter_range": [100000000, 300000000],
  "max_length": 256,
  "epochs": 3,
  "micro_batch_size": 8,
  "gradient_accumulation_steps": 4,
  "learning_rate": 0.00002,
  "weight_decay": 0.01,
  "gradient_clip": 1.0,
  "seed": 42,
  "warmup_fraction": 0.1,
  "early_stopping_patience": 1,
  "supervision": "synthetic_machine_labels_not_human_gold",
  "unknown_handling": "mask_each_unknown_label_in_loss_and_metrics",
  "selection": "lowest_combined_validation_masked_log_loss",
  "threshold_selection": "per_label_validation_max_f1_grid_0.05_to_0.95",
  "calibration": "per_label_temperature_on_calibration_only_logT_in_-2_to_2",
  "promotion_gate": "validation_log_loss_better_than_old_model_in_every_source_language_and_combined_better_than_tfidf",
  "test_role": "one_frozen_evaluation_after_selection_and_calibration",
  "development_only": true
}
